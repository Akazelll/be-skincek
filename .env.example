APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# TRUSTED_PROXIES=* — percayai header X-Forwarded-For dari proxy/tunnel (ngrok, Cloudflare) agar
# request->ip() & lokasi login-activity terbaca IP publik asli. Isi '*' untuk semua, atau daftar IP/CIDR
# dipisah koma (mis. 10.0.0.0/8,100.64.0.0/10) untuk produksi.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,sentry
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Pure token-based auth (Sanctum): kosongkan agar tidak ada domain SPA (stateful)
SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (S3-compatible) - untuk penyimpanan media prediction
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skincek
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Media disk: local (development) / r2 (production)
MEDIA_DISK=local

VITE_APP_NAME="${APP_NAME}"

ML_DRIVER=http
ML_BASE_URL=https://akazelll-face-skin-predict.hf.space
ML_TIMEOUT=30
ML_RETRIES=2

# Observability - Sentry (isi SENTRY_DSN hanya di production)
SENTRY_DSN=
SENTRY_LARAVEL_TRACES_SAMPLE_RATE=0.0
SENTRY_LARAVEL_TRACE_PARENT_SAMPLE_RATE=0.0

# Backup & data retention
BACKUP_RETENTION_DAYS=30
ACCOUNT_DELETION_GRACE_DAYS=30
# Untuk upload backup ke Cloudflare R2, tambahkan disk 'backups' (driver s3, S3-compatible
# endpoint) di config/filesystems.php - isi AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY di atas
# dengan R2 Token Access.

GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=

# Push notification (FCM HTTP v1 API) - isi saat siap produksi
FCM_ENABLED=false
FCM_PROJECT_ID=
# Path ke service account JSON, atau isi string JSON-nya langsung
FCM_CREDENTIALS_JSON=
# FCM_API_URL=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_DURATION=1440

# Kuota pesan gratis user ke semua dokter (kuota global)
CHAT_FREE_MESSAGE_LIMIT=3

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
