    {
      "name": "2. Scan (Output Terbaru: Rekomendasi Perawatan + Skincare)",
      "description": "Scan upload & livecam. Verifikasi field TERBARU: treatment_recommendations (TIPS) + skincare_recommendations (PRODUK).",
      "item": [
        {
          "name": "B1. Scan Upload (foto wajah jelas → 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Scan upload berhasil (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('scan_mode = upload', () => pm.expect(json.data.scan_mode).to.eql('upload'));",
                  "pm.test('confidence 0-1', () => {",
                  "    pm.expect(json.data.confidence).to.be.at.least(0);",
                  "    pm.expect(json.data.confidence).to.be.at.most(1);",
                  "});",
                  "pm.test('severity_score 0-100', () => {",
                  "    pm.expect(json.data.severity_score).to.be.at.least(0);",
                  "    pm.expect(json.data.severity_score).to.be.at.most(100);",
                  "});",
                  "",
                  "// === FIELD TERBARU: skin_concern ===",
                  "pm.test('skin_concern punya name + description (ID)', () => {",
                  "    pm.expect(json.data.skin_concern).to.be.an('object');",
                  "    pm.expect(json.data.skin_concern.name).to.be.a('string');",
                  "    pm.expect(json.data.skin_concern.description).to.be.a('string').and.to.have.length.greaterThan(0);",
                  "});",
                  "",
                  "// === FIELD TERBARU: other_concerns ===",
                  "pm.test('other_concerns adalah array', () => {",
                  "    pm.expect(json.data.other_concerns).to.be.an('array');",
                  "});",
                  "",
                  "// === FIELD TERBARU: treatment_recommendations (TIPS) ===",
                  "pm.test('treatment_recommendations adalah array', () => {",
                  "    pm.expect(json.data.treatment_recommendations).to.be.an('array');",
                  "});",
                  "if (json.data.treatment_recommendations.length > 0) {",
                  "    pm.test('Tips punya struktur lengkap', () => {",
                  "        const t = json.data.treatment_recommendations[0];",
                  "        pm.expect(t.uuid).to.be.a('string');",
                  "        pm.expect(t.title).to.be.a('string');",
                  "        pm.expect(t.recommendation_text).to.be.a('string').and.to.have.length.greaterThan(0);",
                  "        pm.expect(['low','medium','high']).to.include(t.priority_level);",
                  "    });",
                  "    pm.test('Tips urut high→medium→low', () => {",
                  "        const order = { high: 0, medium: 1, low: 2 };",
                  "        for (let i = 1; i < json.data.treatment_recommendations.length; i++) {",
                  "            pm.expect(order[json.data.treatment_recommendations[i].priority_level])",
                  "              .to.be.at.least(order[json.data.treatment_recommendations[i-1].priority_level]);",
                  "        }",
                  "    });",
                  "}",
                  "",
                  "// === FIELD TERBARU: skincare_recommendations (PRODUK) ===",
                  "pm.test('skincare_recommendations adalah array', () => {",
                  "    pm.expect(json.data.skincare_recommendations).to.be.an('array');",
                  "});",
                  "if (json.data.skincare_recommendations.length > 0) {",
                  "    pm.test('Produk punya struktur lengkap', () => {",
                  "        const p = json.data.skincare_recommendations[0];",
                  "        pm.expect(p.uuid).to.be.a('string');",
                  "        pm.expect(p.name).to.be.a('string');",
                  "        pm.expect(p.category).to.be.a('string');",
                  "        pm.expect(['laki_laki','perempuan','unisex']).to.include(p.gender);",
                  "        pm.expect(p.key_ingredients).to.be.a('string');",
                  "        pm.expect(p.usage_instruction).to.be.a('string');",
                  "        pm.expect(p.skin_type).to.be.a('string');",
                  "        pm.expect(p.doctor).to.be.a('string');",
                  "    });",
                  "}",
                  "",
                  "pm.test('disclaimer tampil', () => {",
                  "    pm.expect(json.data.disclaimer).to.be.a('string').and.to.have.length.greaterThan(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('scan_uuid', json.data.uuid);",
                  "pm.collectionVariables.set('scan_image_url', json.data.image_url);",
                  "console.log('=== HASIL SCAN ===');",
                  "console.log('predicted_class :', json.data.predicted_class);",
                  "console.log('skin_concern    :', json.data.skin_concern?.name);",
                  "console.log('confidence      :', json.data.confidence);",
                  "console.log('severity        :', json.data.severity_score, '/', json.data.severity_level);",
                  "console.log('other_concerns  :', json.data.other_concerns.length, 'items');",
                  "console.log('=== TIPS PERAWATAN:', json.data.treatment_recommendations.length, 'items ===');",
                  "json.data.treatment_recommendations.forEach(t => console.log(' -', '[' + t.priority_level + ']', t.title));",
                  "console.log('=== PRODUK SKINCARE:', json.data.skincare_recommendations.length, 'items ===');",
                  "json.data.skincare_recommendations.forEach(p => console.log(' -', p.name, '(' + p.category + ',', p.skin_type + ')'));"
                ]
              }
            }
          ],
